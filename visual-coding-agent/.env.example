# Use a Chat Completions model with image input and function calling.
OPENAI_CHAT_ENDPOINT=https://your-provider.example/v1/chat/completions
OPENAI_MODEL=your-vision-model
OPENAI_API_KEY_FILE=/absolute/path/to/model-key.txt

# Alternatively use OPENAI_API_KEY, or a custom configuration file:
# OPENAI_API_KEY=your-key
# VC_MODEL_CONFIG=configs/chat-completions.example.json
